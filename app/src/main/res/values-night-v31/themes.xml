<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all theming; this just gives an edge-to-edge, action-bar-free window,
         plus Rash Music's own system splash (Android 12+). The animated in-app splash
         (RashSplash) takes over once the first frame is ready. -->
    <style name="Theme.BitChord" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">#FF050505</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
    </style>
</resources>
